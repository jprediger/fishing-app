# Copie para .env e ajuste para produção. O .env NÃO deve ser commitado.
# Em desenvolvimento (docker compose up -d) os defaults abaixo já bastam.

# Banco (usado pelo container postgres e pelo backend)
POSTGRES_DB=fishingdb
POSTGRES_USER=fishing
POSTGRES_PASSWORD=troque-esta-senha-em-producao

# Perfil ativo do Spring (dev | prod)
SPRING_PROFILES_ACTIVE=prod
